{
	"schemaVersion": 1,
	"id": "verticalcut",
	"version": "${version}",
	"name": "Vertical Cut",
	"description": "Shows a vertical cross-section of the terrain in front of you, like an ultrasound scan of the world.",
	"authors": [
		"Claude",
		"Konitor"
	],
	"contact": {
		"homepage": "https://github.com/Knito58/vertical-cut",
		"sources": "https://github.com/Knito58/vertical-cut"
	},
	"license": "MIT",
	"icon": "assets/verticalcut/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.knito.verticalcut.VerticalCutMod"
		],
		"client": [
			"de.knito.verticalcut.client.VerticalCutClient"
		],
		"modmenu": [
			"de.knito.verticalcut.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "verticalcut.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
